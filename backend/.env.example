# Backend Environment Variables
# Copy this file to .env and fill in all values
# NEVER commit .env to version control

# Server
PORT=5000
NODE_ENV=development

# Google OAuth 2.0
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/auth/google/callback

# Session (generate a long random string)
SESSION_SECRET=

# Encryption key for storing OAuth tokens (32-character random string)
ENCRYPTION_KEY=

# Supabase — from your Supabase project dashboard
# Project Settings > API
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Supabase PostgreSQL direct connection URL — for session store
# Project Settings > Database > Connection string > URI (with your password filled in)
SUPABASE_DB_URL=

# Anthropic Claude API
ANTHROPIC_API_KEY=

# Frontend URL (for CORS and OAuth redirect)
FRONTEND_URL=http://localhost:3000
